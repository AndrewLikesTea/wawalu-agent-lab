{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/contracts/integrations/synthetic-cohort/v1/schema.json",
  "title": "Local-only synthetic cohort snapshot",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "snapshot", "contract_metadata", "cohorts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "wawalu.integration.synthetic-cohort"},
    "snapshot": {"type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "generated_at", "completeness"],
      "properties": {"snapshot_id": {"type": "string", "pattern": "^syn_[a-z0-9_-]+$"},
        "generated_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"},
        "completeness": {"enum": ["complete", "partial"]}}},
    "contract_metadata": {"type": "object", "additionalProperties": false,
      "required": ["publisher", "license", "method_version"],
      "properties": {"publisher": {"type": "string"}, "license": {"type": "string"}, "method_version": {"type": "string"}}},
    "cohorts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cohort"}}
  },
  "$defs": {"cohort": {"type": "object", "additionalProperties": false,
    "required": ["industry_band", "organization_size_band", "task_volume_band", "member_count", "measures"],
    "properties": {"industry_band": {"enum": ["software", "financial_services", "healthcare", "other"]},
      "organization_size_band": {"enum": ["small", "medium", "large"]}, "task_volume_band": {"enum": ["low", "medium", "high"]},
      "member_count": {"type": "integer", "minimum": 20}, "measures": {"type": "object", "additionalProperties": false,
        "required": ["task_success_rate", "cost_per_successful_task_usd", "monthly_cost_usd"],
        "properties": {"task_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "cost_per_successful_task_usd": {"type": "number", "minimum": 0}, "monthly_cost_usd": {"type": "number", "minimum": 0}}}}}}
}
